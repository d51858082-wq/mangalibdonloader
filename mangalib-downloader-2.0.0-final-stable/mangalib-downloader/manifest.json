{
  "manifest_version": 3,
  "name": "Lib Downloader",
  "version": "2.0.0",
  "description": "Скачивание глав с MangaLib, SlashLib и HentaiLib в CBZ и PDF; для HentaiLib можно извлекать полностью загруженные изображения из открытой страницы чтения.",
  "action": {
    "default_title": "Скачать главы (MangaLib, SlashLib, HentaiLib)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "declarativeNetRequest",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.cdnlibs.org/*",
    "https://mangalib.me/*",
    "https://*.mangalib.me/*",
    "https://mangalib.org/*",
    "https://*.mangalib.org/*",
    "https://slashlib.me/*",
    "https://*.slashlib.me/*",
    "https://slashlib.org/*",
    "https://*.slashlib.org/*",
    "https://hentailib.me/*",
    "https://*.hentailib.me/*",
    "https://hentailib.org/*",
    "https://*.hentailib.org/*",
    "https://*.imglib.info/*",
    "https://*.cdnlibs.org/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
